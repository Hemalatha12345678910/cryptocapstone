# Database Configuration
# Set DB_ENGINE=mysql to use MySQL, or DB_ENGINE=sqlite to use SQLite directly.
# If DB_ENGINE=mysql is selected but MySQL is unreachable, the system automatically falls back to SQLite.
DB_ENGINE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=smartgrid_honeypot
SQLITE_PATH=smartgrid_honeypot.db

# MQTT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
MQTT_FALLBACK_SIMULATION=true

# Honeypot Configuration
HONEYPOT_HOST=0.0.0.0
HONEYPOT_SSH_PORT=2222
HONEYPOT_TELNET_PORT=2223
HONEYPOT_LOG_PATH=logs/cowrie.json

# Cryptographic Key Paths
KEY_DIR=keys
RSA_PRIVATE_KEY_PATH=keys/threat_intel_private.pem
RSA_PUBLIC_KEY_PATH=keys/threat_intel_public.pem
AES_MASTER_KEY_HEX=

# Simulation Parameters
NUM_SMART_HOMES=10
SIMULATION_INTERVAL_SEC=2.0
TOTAL_SIMULATION_STEPS=100

